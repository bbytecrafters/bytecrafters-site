								<rect x="30" y="46" width="110" height="6" rx="3" class="v-bar v-hi" />
								<rect x="30" y="60" width="84" height="6" rx="3" class="v-bar" />
								<rect x="18" y="74" width="46" height="6" rx="3" class="v-bar" />
								<rect x="70" y="73" width="3" height="9" class="v-cursor" />
