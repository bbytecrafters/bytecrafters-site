---
// src/components/Footer.astro
const currentYear = new Date().getFullYear();
const isEnglish = Astro.url.pathname.startsWith('/en');
---
<footer class="footer-tech">
    <div class="footer-tech-container">
        <div class="footer-tech-logo">
            BYTE<span style="color: var(--neon-blue);">CRAFTERS</span>
        </div>
        <p class="footer-tech-copy">
            &copy; {currentYear} ByteCrafters. {isEnglish ? 'All rights reserved.' : 'Με επιφύλαξη παντός δικαιώματος.'}
        </p>
        <div class="footer-tech-links">
            <a href={isEnglish ? '/en/privacy' : '/privacy'}>
                {isEnglish ? 'Privacy Policy' : 'Πολιτική Απορρήτου'}
            </a>
            <a href={isEnglish ? '/en/terms' : '/terms'}>
                {isEnglish ? 'Terms of Service' : 'Όροι Χρήσης'}
            </a>
        </div>
    </div>
</footer>